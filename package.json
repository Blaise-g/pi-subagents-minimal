{
  "name": "pi-subagents-minimal",
  "version": "0.2.0",
  "description": "A deliberately narrow Subagent delegation extension for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blaise-g/pi-subagents-minimal.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "packageManager": "bun@1.4.0",
  "files": ["extensions", "src", "agents", "README.md", "LICENSE"],
  "pi": { "extensions": ["./extensions/subagents-minimal.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/bun": "1.3.10",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "pack:test": "bun test test/packed.test.ts",
    "budget:test": "bun test test/context-budget.test.ts",
    "release:verify": "bun tools/release.ts verify-inventory"
  }
}
