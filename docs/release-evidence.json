{
  "schemaVersion": 1,
  "evidenceCatalog": {
    "agent-bytes": {
      "kind": "deterministic",
      "file": "test/extension.test.ts",
      "assertion": "packaged Subagent bytes equal the approved fixture"
    },
    "allocation-invariance": {
      "kind": "deterministic",
      "file": "test/projection.test.ts",
      "assertion": "allocation is permutation-independent and protects complete report paths"
    },
    "branch-semantics": {
      "kind": "deterministic",
      "file": "test/recovery.test.ts",
      "assertion": "branch switching rebuilds only from the new active branch"
    },
    "cancellation": {
      "kind": "deterministic",
      "file": "test/cancellation.test.ts",
      "assertion": "cancellation is shared-deadline bounded, idempotent, and preserves completed siblings"
    },
    "canonical-allocation": {
      "kind": "deterministic",
      "file": "test/projection.test.ts",
      "assertion": "canonical allocator matches an independent Unicode waterline model"
    },
    "configuration": {
      "kind": "deterministic",
      "file": "test/config.test.ts",
      "assertion": "startup configuration"
    },
    "consumption-marker": {
      "kind": "deterministic",
      "file": "test/recovery.test.ts",
      "assertion": "marker failure leaves unread and permits byte-identical duplicate delivery"
    },
    "context-payload-budget": {
      "kind": "budget",
      "file": "test/context-budget.test.ts",
      "assertion": "tool surfaces stay under ceilings and within 10% of reviewed baselines"
    },
    "context-token-budget": {
      "kind": "budget",
      "file": "test/context-budget.test.ts",
      "assertion": "both provider repetitions independently satisfy the token ceiling"
    },
    "diagnostic-bounds": {
      "kind": "deterministic",
      "file": "test/finalization-faults.test.ts",
      "assertion": "diagnostics are UTF-8 bounded, deterministically deduplicated, and newest eight are retained"
    },
    "evidence-inventory": {
      "kind": "release",
      "file": "test/release.test.ts",
      "assertion": "the assertion inventory covers every contract section and change-to-evidence assertion"
    },
    "fifo": {
      "kind": "deterministic",
      "file": "test/batch.test.ts",
      "assertion": "one extension-wide FIFO spans Delegations and never exceeds capacity"
    },
    "finalization-faults": {
      "kind": "deterministic",
      "file": "test/finalization-faults.test.ts",
      "assertion": "projection and append faults remain finalizing and inspect retries immutable work in order"
    },
    "flat-batch": {
      "kind": "deterministic",
      "file": "test/batch.test.ts",
      "assertion": "flat batch is all-settled and returns input order after reverse completion"
    },
    "host-compatibility": {
      "kind": "deterministic",
      "file": "test/extension.test.ts",
      "assertion": "host compatibility"
    },
    "malformed-persistence": {
      "kind": "deterministic",
      "file": "test/recovery.test.ts",
      "assertion": "applies matching markers in order and reports malformed and mismatched entries"
    },
    "notification-fault": {
      "kind": "deterministic",
      "file": "test/finalization-faults.test.ts",
      "assertion": "notification and activation faults leave persisted result terminal and notification is not retried"
    },
    "output-length": {
      "kind": "deterministic",
      "file": "test/unsuccessful-single.test.ts",
      "assertion": "output length is a run failure, not success"
    },
    "packed-artifact": {
      "kind": "packed",
      "file": "test/packed.test.ts",
      "assertion": "exact packed artifact is allowlisted and self-describing"
    },
    "parent-surface": {
      "kind": "budget",
      "file": "test/context-budget.test.ts",
      "assertion": "tools and parent prompt contain no package instructions"
    },
    "preflight": {
      "kind": "deterministic",
      "file": "test/preflight.test.ts",
      "assertion": "single Delegation preflight"
    },
    "queue-timeout": {
      "kind": "deterministic",
      "file": "test/batch.test.ts",
      "assertion": "queue timeout settles only the waiting child and does not cancel its sibling"
    },
    "recovery": {
      "kind": "deterministic",
      "file": "test/recovery.test.ts",
      "assertion": "reconstructs unread active-branch envelopes without replaying notification"
    },
    "release-workflow": {
      "kind": "release",
      "file": "test/release.test.ts",
      "assertion": "the publish workflow makes provenance publication depend on every release gate"
    },
    "report-boundary": {
      "kind": "deterministic",
      "file": "test/report.test.ts",
      "assertion": "declared report boundary"
    },
    "report-runtime": {
      "kind": "deterministic",
      "file": "test/report-runtime.test.ts",
      "assertion": "gives a report Subagent only its closure-bound writer and projects path plus summary"
    },
    "running-timeout": {
      "kind": "deterministic",
      "file": "test/unsuccessful-single.test.ts",
      "assertion": "a running timeout wins atomically and retains bounded useful text"
    },
    "shutdown": {
      "kind": "deterministic",
      "file": "test/shutdown.test.ts",
      "assertion": "shutdown uses one grace deadline, rejects admission, persists cancellation, and preserves unread work"
    },
    "successful-lifecycle": {
      "kind": "deterministic",
      "file": "test/successful-single.test.ts",
      "assertion": "runs an isolated generic Subagent and persists v2 before notifying and consuming"
    },
    "typecheck": {
      "kind": "typecheck",
      "file": "package.json",
      "assertion": "\"typecheck\": \"tsc --noEmit\""
    },
    "unknown-id": {
      "kind": "deterministic",
      "file": "test/cancellation.test.ts",
      "assertion": "unknown Delegation ids return a sanitized error"
    },
    "git-process-boundary": {
      "kind": "deterministic",
      "file": "test/git-boundary.test.ts",
      "assertion": "guarded Git process boundary"
    },
    "git-semantics-bounds": {
      "kind": "deterministic",
      "file": "test/git-diff.test.ts",
      "assertion": "literal path filtering includes both rename endpoints and exact UTF-8 truncation metadata"
    },
    "dogfood-qualification": {
      "kind": "release",
      "file": "docs/dogfood-qualification.json",
      "assertion": "deterministic-dogfood-candidate"
    },
    "review-workflows": {
      "kind": "deterministic",
      "file": "test/review-workflows.test.ts",
      "assertion": "versioned parent review skills use independent strict 0.2.0 Tasks"
    }
  },
